{
  "name": "livingforma",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"pnpm --filter @livingforma/api dev\" \"pnpm --filter @livingforma/web dev\"",
    "build": "pnpm --filter @livingforma/web build && pnpm --filter @livingforma/api build",
    "start": "node apps/api/dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "vitest": "^3.2.0",
    "concurrently": "^9.2.0",
    "@playwright/test": "^1.55.0"
  }
}
