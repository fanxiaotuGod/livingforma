const origin='http://localhost:4349',root='docs/memory/handoffs/frontend';let generationCalls=0;const writes:string[]=[],checks:string[]=[],errors:string[]=[],reports:Array<{id:string;revision:number;ok:boolean}>=[];
function proposal(current=readingDefinition()):Proposal{return {entitySchema:current.entitySchema,appSpec:{...current.appSpec,title:'Bounded choices',components:[componentSchema.parse({id:'website',type:'generated-site',version:1,fields:current.entitySchema.fields.filter(field=>field.public).map(field=>field.id),actionIds:current.appSpec.actions.map(action=>action.id)})],generated:{format:'html-v1',bridgeVersion:1,assetIds:[],html:'<main><h1>Make a choice</h1><button id="pick">Choose image</button><button id="remove">Remove first record</button><p id="result" role="status"></p></main>',css:'body{font:16px system-ui;background:#f2ede5;color:#304032}main{padding:24px}h1{font:36px Georgia}button{font:inherit;margin:10px;padding:12px;border:1px solid #888;background:white;border-radius:8px}',js:`(async()=>{let state=await lf.ready;lf.subscribe(next=>state=next);const out=document.getElementById('result');document.getElementById('pick').onclick=async()=>{out.textContent='Waiting for your image';try{const asset=await lf.pickImage();await lf.update(state.records[0].id,{photo:asset.assetId});out.textContent='Image saved'}catch(error){out.textContent=error.message}};document.getElementById('remove').onclick=async()=>{out.textContent='Waiting for confirmation';try{await lf.remove(state.records[0].id);out.textContent='Record removed'}catch(error){out.textContent=error.message}};lf.reportReady()})();`}},summary:'Offline human-choice and check-retry fixture.',source:'gemini',capabilityGaps:[]}}
const generator:SiteGenerator=async input=>{generationCalls++;return proposal(input.current??undefined)};
const api=await buildApp({db:await createDatabase(),origin,localDemo:true,siteGenerator:generator,staticDir:'/tmp/livingforma-lf234-web'});const state=(await api.store.getSpace('reading'))!;state.definition!.entitySchema.fields.push({id:'photo',label:'Photo reference',type:'text',public:true,required:false});applyProposal(state,proposal(state.definition!));await api.store.db.transaction(tx=>api.store.event(state,'definition.published',tx));await api.app.listen({host:'127.0.0.1',port:4349});
const browser=await chromium.launch({headless:true,channel:'chrome'}),context=await browser.newContext({viewport:{width:1280,height:950},reducedMotion:'reduce'});await context.request.post(`${origin}/auth/local`,{headers:{origin},data:{persona:'owner'}});const page=await context.newPage();page.setDefaultTimeout(15000);await page.clock.install();page.on('pageerror',e=>errors.push(e.message));page.on('request',request=>{if(request.method()==='POST'&&/\/(assets|actions)$/.test(new URL(request.url()).pathname))writes.push(new URL(request.url()).pathname);if(request.method()==='POST'&&request.url().endsWith('/preview')){const body=request.postDataJSON();reports.push({id:request.url().split('/').at(-2)!,revision:body.sourceRevision,ok:body.ok})}});
