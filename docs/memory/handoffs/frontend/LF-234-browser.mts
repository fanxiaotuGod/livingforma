try{
 await page.goto(`${origin}/s/reading`);await expect(page.locator('.generated-frame-status [role=status]')).toHaveText('Website ready');
 await check('An image selected after 31 seconds still reaches the real host and saves its reference',async()=>{await click('Choose image');await expect(page.getByRole('heading',{name:'Add an image',exact:true})).toBeVisible();await page.clock.fastForward(31000);await expect(frame().getByRole('status')).toHaveText('Waiting for your image');const image=await page.evaluate(()=>{const canvas=document.createElement('canvas');canvas.width=20;canvas.height=20;canvas.getContext('2d')!.fillRect(0,0,20,20);return canvas.toDataURL('image/png').split(',')[1]});await page.locator('input[type=file]').setInputFiles({name:'choice.png',mimeType:'image/png',buffer:Buffer.from(image,'base64')});await expect(frame().getByRole('status')).toHaveText('Image saved');expect((await api.store.getSpace('reading'))!.records[0].values.photo).toMatch(/^asset_/);expect(writes).toHaveLength(2)});
 await check('Explicit image cancellation and keeping a record send no writes',async()=>{const before=writes.length;await click('Choose image');await page.getByRole('button',{name:'Cancel image selection'}).click();await expect(frame().getByRole('status')).toContainText('cancelled');await expect(page.getByRole('dialog')).toHaveCount(0);await click('Remove first record');await page.getByRole('button',{name:'Keep record',exact:true}).click();await expect(frame().getByRole('status')).toContainText('Your record was kept');expect(writes).toHaveLength(before)});
 await check('120-second image expiry closes the host dialog and ignores a late native selection',async()=>{const before=writes.length;await click('Choose image');await expect(page.getByRole('heading',{name:'Add an image',exact:true})).toBeVisible();const oldInput=await page.locator('input[type=file]').elementHandle();await page.clock.fastForward(120001);await expect(page.getByRole('dialog')).toHaveCount(0);await expect(frame().getByRole('status')).toContainText('Image selection expired');await lateFile(oldInput);expect(writes).toHaveLength(before);await page.screenshot({path:`${root}/LF-234-choice-expired.png`})});
 await check('120-second deletion expiry keeps the record; a fresh confirmation after 31 seconds still works',async()=>{const before=writes.length,count=(await api.store.getSpace('reading'))!.records.length;await click('Remove first record');const oldButton=await page.getByRole('button',{name:'Delete record',exact:true}).elementHandle();await page.clock.fastForward(120001);await expect(page.getByRole('dialog')).toHaveCount(0);await expect(frame().getByRole('status')).toContainText('Delete confirmation expired');await oldButton!.evaluate(button=>button.click());expect(writes).toHaveLength(before);expect((await api.store.getSpace('reading'))!.records).toHaveLength(count);await click('Remove first record');await expect(page.getByRole('heading',{name:'Delete this record?',exact:true})).toBeVisible();await page.clock.fastForward(31000);await page.getByRole('button',{name:'Delete record',exact:true}).click();await expect(frame().getByRole('status')).toHaveText('Record removed');expect((await api.store.getSpace('reading'))!.records).toHaveLength(count-1)});
 await check('Identity changes cancel the outstanding choice and ignore its old selection',async()=>{const before=writes.length;await click('Choose image');await expect(page.getByRole('heading',{name:'Add an image',exact:true})).toBeVisible();const input=await page.locator('input[type=file]').elementHandle();await context.request.post(`${origin}/auth/local`,{headers:{origin},data:{persona:'participant'}});await page.evaluate(()=>window.dispatchEvent(new Event('focus')));await expect(page.getByRole('button',{name:'Open the space designer'})).toHaveCount(0);await expect(page.getByRole('dialog')).toHaveCount(0);await lateFile(input);expect(writes).toHaveLength(before);await context.request.post(`${origin}/auth/local`,{headers:{origin},data:{persona:'owner'}});await page.reload();await expect(page.locator('.generated-frame-status [role=status]')).toHaveText('Website ready')});
 await check('Leaving the space cancels a choice before any upload can be sent',async()=>{const before=writes.length;await click('Choose image');await expect(page.getByRole('heading',{name:'Add an image',exact:true})).toBeVisible();const input=await page.locator('input[type=file]').elementHandle();await page.evaluate(()=>{history.pushState(null,'','/s/habits');window.dispatchEvent(new PopStateEvent('popstate'))});await expect(page).toHaveURL(`${origin}/s/habits`);await expect(page.getByRole('dialog')).toHaveCount(0);await lateFile(input);expect(writes).toHaveLength(before);await page.locator('.space-nav a[href="/s/reading"]').click();await expect(page.locator('.generated-frame-status [role=status]')).toHaveText('Website ready')});
 await check('A failed ready report waits for explicit retry, then checks the same job/revision without a model call',async()=>{let reject=true;await context.route('**/generations/*/preview',async route=>{if(reject&&route.request().postDataJSON().ok){reject=false;return route.fulfill({status:503,contentType:'application/json',body:JSON.stringify({error:{code:'FIXTURE_NETWORK_FAILURE',message:'Offline fixture: the check could not be delivered.'}})})}return route.continue()});await page.getByRole('button',{name:'Open the space designer'}).click();const prompt='Keep this fixture, and check its existing interactions';await page.getByRole('textbox',{name:'Describe your website'}).fill(prompt);await page.getByRole('button',{name:'Create website',exact:true}).click();await expect(page.getByRole('button',{name:'Retry preview check'})).toBeVisible();expect(generationCalls).toBe(1);expect(reports).toHaveLength(1);await expect(page.getByRole('button',{name:'Publish website',exact:true})).toBeDisabled();await page.getByRole('tab',{name:'HTML',exact:true}).click();await page.getByRole('tab',{name:'Preview',exact:true}).click();await page.clock.fastForward(4000);await expect(page.locator('.is-preview .generated-frame-status [role=status]')).toHaveText('Website ready');expect(reports).toHaveLength(1);await page.screenshot({path:`${root}/LF-234-preview-retry.png`});await page.getByRole('tab',{name:'HTML',exact:true}).click();await page.getByRole('button',{name:'Retry preview check'}).click();await expect(page.getByRole('tab',{name:'Preview',exact:true})).toHaveAttribute('aria-selected','true');await expect(page.getByRole('button',{name:'Publish website',exact:true})).toBeEnabled();expect(reports).toHaveLength(2);expect(reports[1]).toEqual(reports[0]);expect(generationCalls).toBe(1);await expect(page.getByRole('textbox',{name:'Describe your website'})).toHaveValue(prompt);await expect(page.getByRole('button',{name:'Report an issue',exact:true})).toBeVisible();await page.getByRole('button',{name:'Report an issue',exact:true}).click();await expect(page.getByLabel('What should work differently?')).toBeVisible();expect((await api.store.getSpace('reading'))!.definition!.definitionVersion).toBe(2)});
 expect(errors).toEqual([]);await writeFile(`${root}/LF-234-browser-results.json`,JSON.stringify({at:new Date().toISOString(),scope:'Real Chrome/MessageChannel/current backend bootstrap/local API/PGlite; virtual clock for human timeouts, offline generator, explicit transport rejection fixture. No providers or shared apps/web/dist rebuild.',checks,writes,generationCalls,reports,errors},null,2));
}catch(error){await page.screenshot({path:`${root}/LF-234-failed.png`,fullPage:true});await writeFile(`${root}/LF-234-failed.json`,JSON.stringify({error:String(error),body:await page.locator('body').innerText(),writes,reports,generationCalls,errors},null,2));throw error}finally{await context.close();await browser.close();await api.app.close()}
