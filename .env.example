# Copy to .env locally. Never commit credentials, and never use VITE_* for secrets.
APP_ORIGIN=http://localhost:5173
HOST=127.0.0.1
PORT=3001
# Explicit local test identities. Disabled unconditionally in production.
ENABLE_LOCAL_DEMO=true
# Empty means local on-disk PGlite. Production requires a persistent PostgreSQL URL.
DATABASE_URL=
# Exact callback: APP_ORIGIN/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only enable after verifying a free-tier account; no automatic paid fallback.
GEMINI_API_KEY=
GEMINI_FREE_TIER_VERIFIED=false
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_DAILY_REQUEST_LIMIT=30
AGENT_MODE=gemini
# Set both verified flags true only for an independently verified account.
# Offline fixture development can explicitly override AGENT_MODE=local.
ELEVENLABS_API_KEY=
ELEVENLABS_ALLOWANCE_VERIFIED=false
# Media period verified-2026-10-03 and limits (60 STT seconds / 1000 TTS
# UTF-16 characters) are fixed in Agent + DB source, not environment settings.
# Both providers use the existing DATABASE_URL ledgers; do not reset them.
